# ==============================================================================
# Gmail API Configuration
# ==============================================================================
# Your Gmail API Key / OAuth Access Token
GMAIL_API_KEY=your_gmail_api_key_or_access_token

# (Optional) If using Google Cloud OAuth with automated refresh:
# GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_client_secret
# GMAIL_REFRESH_TOKEN=your_refresh_token

# ==============================================================================
# Ollama AI Configuration
# ==============================================================================
# Base URL: http://127.0.0.1:11434 for local Ollama, or Ollama Cloud URL
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Your Ollama API key (if using Ollama Cloud or authenticated endpoint)
OLLAMA_API_KEY=your_ollama_api_key
# Model name to use for triage (e.g., deepseek-v4-flash:cloud, gemma4:31b-cloud)
OLLAMA_MODEL=deepseek-v4-flash:cloud

# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Bot Token from Telegram's @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your personal Chat ID from Telegram's @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id
