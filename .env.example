# ==============================================================================
# Email IMAP Configuration
# ==============================================================================
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
# Host is typically imap.gmail.com with port 993 (SSL)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_email_app_password

# ==============================================================================
# Ollama AI Configuration
# ==============================================================================
# Base URL: http://127.0.0.1:11434 for local Ollama, or Ollama Cloud URL
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Your Ollama API key (if using Ollama Cloud or authenticated endpoint)
OLLAMA_API_KEY=your_ollama_api_key
# Model name to use for triage (e.g., deepseek-v4-flash:cloud, gemma4:31b-cloud)
OLLAMA_MODEL=deepseek-v4-flash:cloud

# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Bot Token from Telegram's @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your personal Chat ID from Telegram's @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id
